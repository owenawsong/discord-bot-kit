{
  "name": "@owenawsong/discord-bot-kit",
  "version": "0.2.1",
  "description": "Build and test Discord bots locally with reusable recipes, state inspection, scenarios and agent tools.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "discord-bot-kit": "dist/src/cli.js",
    "guildwright": "dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./discord": "./dist/src/discord.js"
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "src",
    "public",
    "skills",
    "docs",
    "assets",
    "scripts",
    "examples",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "npm run build && node dist/src/cli.js playground",
    "docs:demo": "npm run build && node scripts/build-readme-demo.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run test && node dist/src/cli.js test --json && node dist/src/cli.js test --recipe signups --json && node dist/src/cli.js test --recipe polls --json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "discord.js": "^14.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "bot-development",
    "mcp",
    "coding-agents",
    "testing",
    "simulation"
  ],
  "author": "Owen Song",
  "repository": {
    "type": "git",
    "url": "https://github.com/owenawsong/discord-bot-kit.git"
  }
}
